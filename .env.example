NODE_ENV=development
PORT=8091

# Docker image (used by docker-compose.yml)
DOCKER_USERNAME=yourdockerhubusername
IMAGE_TAG=latest

# Database — credentials only; host/port default to pgbouncer:6432
DB_USER=user_svc
DB_PASSWORD=
DB_NAME=katisha_users
# DB_HOST=pgbouncer  (default)
# DB_PORT=6432       (default)

# Redis — password only; host/port default to redis:6379
REDIS_PASSWORD=
# REDIS_HOST=redis   (default)
# REDIS_PORT=6379    (default)

# RabbitMQ — credentials only; host/port default to rabbitmq:5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# RABBITMQ_HOST=rabbitmq  (default)
# RABBITMQ_PORT=5672      (default)

# JWT — Ed25519 private key (PEM, single-line with literal \n)
# Generate with:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem  # for api-gw JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=""
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies — set false locally (plain HTTP)
COOKIE_SECURE=false
TRUST_PROXY=1

# App URLs — passenger frontend and staff frontend
APP_URL=http://www.katisha.online

# S3 — public endpoint used for both signing and uploads
# Locally: http://localhost:8333 (requires cdn port exposed in its docker-compose)
# Public endpoint — used to SIGN presigned URLs the browser hits.
# Production: https://cdn.katisha.online
S3_ENDPOINT=http://localhost:8333
# Internal endpoint — server-side ops only (delete), reached directly over
# katisha-net so they don't hairpin through the public proxy. Always required.
# Production: http://cdn:8333   |   Local dev: set equal to S3_ENDPOINT
S3_INTERNAL_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=katisha
# Private bucket for sensitive files (org documents). Its own SeaweedFS identity;
# NOT anonymously readable — served only via short-lived presigned URLs.
S3_PRIVATE_BUCKET=katisha-private
S3_PRIVATE_ACCESS_KEY=
S3_PRIVATE_SECRET_KEY=
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRES_IN=300

# OTP (all optional — defaults shown)
# OTP_TTL_SECONDS=300
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=3
# OTP_WINDOW_SECONDS=600

# Rate limiting (all optional — defaults shown)
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_RESET_MAX=3
# RATE_LIMIT_RESET_WINDOW_SECONDS=3600
