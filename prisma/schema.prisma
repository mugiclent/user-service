generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserType {
  passenger
  staff
}

enum UserStatus {
  active
  pending_verification
  suspended
  pending_deletion
  deleted
}

enum LoginChannel {
  phone
  email
}

enum OrgType {
  company
  cooperative
  coop_member
}

enum OrgStatus {
  unverified
  pending
  active
  suspended
  rejected
}


enum OrgDocType {
  business_certificate
  rep_id
}

enum PermissionAction {
  read
  create
  update
  delete
  invite
  suspend
  assign_role
  approve
  upload
  export
  receive
  cancel
  refund
  topup
  pay
  override
  read_manifest
  // `manage` is intentionally NOT a literal action — it is reserved for CASL's
  // wildcard ("any action"). Lifecycle verbs below replace the old literal use.
  configure
  provision
  validate
}

enum PermissionSubject {
  User
  Org
  Role
  Invitation
  OrgDocument
  AuditLog
  Notification
  Permission
  Trip
  Route
  Location
  Bus
  Ticket
  Price
  Wallet
  Payment
  Refund
  Payout
  Finance
  Billing
  Commission
  TaxReceipt
  Vsdc
  Report
}


// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Org {
  id                      String    @id @default(uuid())
  name                    String    @unique @db.VarChar(200)
  slug                    String    @unique @db.VarChar(200)
  org_type                OrgType
  status                  OrgStatus @default(pending)
  tin                     String    @unique @db.VarChar(9)
  license_number          String?   @unique @db.VarChar(100)
  contact_first_name         String    @default("") @db.VarChar(100)
  contact_last_name          String    @default("") @db.VarChar(100)
  contact_email              String    @db.VarChar(255)
  contact_phone              String    @db.VarChar(20)
  address                    String?   @db.VarChar(500)
  logo_path                  String?
  parent_org_id              String?
  approved_by                String?
  approved_at                DateTime?
  rejection_reason           String?
  cooperative_approved_at    DateTime?
  cooperative_approved_by    String?
  story                      String?   @db.Text
  cancellations_allowed      Boolean   @default(true)
  billing_day                Int?
  balance                    BigInt    @default(0)
  contact_email_verified_at  DateTime?
  contact_phone_verified_at  DateTime?
  bank_id                    String?   @db.VarChar(36)
  account_number             String?   @db.VarChar(20)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  deleted_at                 DateTime?

  parent_org Org?         @relation("OrgHierarchy", fields: [parent_org_id], references: [id])
  child_orgs Org[]        @relation("OrgHierarchy")
  users      User[]
  roles      Role[]
  documents  OrgDocument[]
  org_otps   OrgOtp[]
  bank       Bank?         @relation(fields: [bank_id], references: [id])

  @@map("orgs")
}

model Bank {
  id         String   @id @default(uuid())
  name       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orgs Org[]

  @@map("banks")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  org_id      String?
  // is_managed marks a platform-seeded default. It is NO LONGER a freeze — an org
  // edits a default by forking a copy-on-write copy (override_of -> default), and
  // is_hidden tombstones a default for one org. See src/utils/overrides.ts.
  is_managed  Boolean  @default(false)
  override_of String?
  is_hidden   Boolean  @default(false)
  created_at  DateTime @default(now())

  org              Org?             @relation(fields: [org_id], references: [id])
  override_parent  Role?            @relation("RoleOverride", fields: [override_of], references: [id], onDelete: Cascade)
  overrides        Role[]           @relation("RoleOverride")
  user_roles       UserRole[]
  invitation_roles InvitationRole[]
  role_grants      RoleGrant[]

  @@unique([slug, org_id])
  @@index([org_id])
  @@map("roles")
}

model User {
  id                         String       @id @default(uuid())
  first_name                 String       @db.VarChar(100)
  last_name                  String       @db.VarChar(100)
  phone_number               String?      @db.VarChar(20)
  phone_verified_at          DateTime?
  email                      String?      @db.VarChar(255)
  email_verified_at          DateTime?
  password_hash              String?
  user_type                  UserType
  status                     UserStatus   @default(pending_verification)
  login_channel              LoginChannel?
  two_factor_enabled         Boolean      @default(false)
  avatar_path                String?
  notif_channel              String[]     @default(["sms", "email"])
  locale                     String       @default("rw") @db.VarChar(5)
  fcm_token                  String?
  org_id                     String?
  driver_license_number      String?      @db.VarChar(100)
  driver_license_verified_at DateTime?
  last_login_at              DateTime?
  balance                    BigInt       @default(0)
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt
  deleted_at                 DateTime?

  org            Org?           @relation(fields: [org_id], references: [id])
  refresh_tokens RefreshToken[]
  user_devices   UserDevice[]
  otps           Otp[]
  user_roles     UserRole[]
  user_grants    UserGrant[]

  @@unique([phone_number, user_type])
  @@unique([email, user_type])
  @@map("users")
}

model Permission {
  id           String            @id @default(uuid())
  code         String            @unique @db.VarChar(60)
  action       PermissionAction
  subject      PermissionSubject
  display_name String            @db.VarChar(100)
  description  String            @db.VarChar(255)
  group        String            @db.VarChar(50)
  scopes       String[]

  @@unique([action, subject])
  @@map("permissions")
}

// A grant is a pattern string assigned to a role or user.
// Pattern format: "{subject|*}:{action|*}:{scope}"   e.g. "*:*:platform", "user:*:own"
// Scope must always be explicit (own | org | platform) — no wildcard on scope.
// is_managed=true means the grant was seeded by the platform and cannot be removed via API.

model RoleGrant {
  id         String   @id @default(uuid())
  role_id    String
  pattern    String   @db.VarChar(80)
  is_managed Boolean  @default(false)
  created_at DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, pattern])
  @@map("role_grants")
}

model UserGrant {
  id         String   @id @default(uuid())
  user_id    String
  pattern    String   @db.VarChar(80)
  is_managed Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern])
  @@map("user_grants")
}

model UserRole {
  user_id    String
  role_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  token_hash          String    @unique
  user_id             String
  device_name         String?   @db.VarChar(200)
  ip_address          String?   @db.VarChar(45)
  user_agent          String?   @db.VarChar(500)
  expires_at          DateTime
  // Hard ceiling for the whole session lineage — carried forward unchanged across
  // rotations so an active session is still forced to re-login after this instant.
  // Nullable for rows created before absolute caps existed (treated as no cap).
  absolute_expires_at DateTime?
  revoked_at          DateTime?
  last_used_at        DateTime?
  created_at          DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model UserDevice {
  id             String    @id @default(uuid())
  user_id        String
  device_name    String?   @db.VarChar(200)
  fcm_token      String    @unique @db.VarChar(500)
  registered_at  DateTime  @default(now())
  last_active_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_devices")
}

model Otp {
  id         String    @id @default(uuid())
  user_id    String
  purpose    String    @db.VarChar(30)
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@map("otps")
}


model Invitation {
  id           String    @id @default(uuid())
  email        String?   @db.VarChar(255)
  phone_number String?   @db.VarChar(20)
  first_name   String    @db.VarChar(100)
  last_name    String    @db.VarChar(100)
  org_id       String?
  invited_by   String
  locale       String?   @db.VarChar(5)
  token_hash   String    @unique
  expires_at   DateTime
  created_at   DateTime  @default(now())

  invitation_roles  InvitationRole[]
  invitation_grants InvitationGrant[]

  @@map("invitations")
}

model InvitationRole {
  invitation_id String
  role_id       String
  created_at    DateTime @default(now())

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([invitation_id, role_id])
  @@map("invitation_roles")
}

model InvitationGrant {
  id            String   @id @default(uuid())
  invitation_id String
  pattern       String   @db.VarChar(80)
  created_at    DateTime @default(now())

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@unique([invitation_id, pattern])
  @@map("invitation_grants")
}

model OrgDocument {
  id         String     @id @default(uuid())
  org_id     String
  doc_type   OrgDocType
  s3_path    String
  mime_type  String     @db.VarChar(100)
  created_at DateTime   @default(now())

  org Org @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@map("org_documents")
}


model OrgOtp {
  id         String    @id @default(uuid())
  org_id     String
  purpose    String    @db.VarChar(30)
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  org Org @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id, purpose])
  @@map("org_otps")
}

// Local projection of the passenger's wallet ledger, fed by payment-service's
// `wallet.transaction.completed` events. Lets us serve transaction history and
// the display balance without a synchronous call to payment-service. No FK to
// User: it is an eventually-consistent projection, not a relational child.
model WalletTransaction {
  id            String   @id @default(uuid())
  owner_id      String   // userId for passengers, orgId for organisations
  owner_type    String   @db.VarChar(20) // PASSENGER | ORGANISATION
  type          String   @db.VarChar(20) // CREDIT | DEBIT (movement)
  source        String?  @db.VarChar(20) // topup | ticket_payment | refund
  reference     String?  // canonical payment ref for the movement
  ticket_id     String?  // set for ticket_payment / refund, so the UI can deep-link
  amount        BigInt
  balance_after BigInt
  occurred_at   DateTime
  created_at    DateTime @default(now())

  @@index([owner_id, owner_type, occurred_at])
  @@map("wallet_transactions")
}
