generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserType {
  passenger
  staff
}

enum UserStatus {
  active
  pending_verification
  suspended
  pending_deletion
  deleted
}

enum LoginChannel {
  phone
  email
}

enum OrgType {
  company
  cooperative
}

enum OrgStatus {
  pending
  active
  suspended
  rejected
}


enum OrgDocType {
  business_certificate
  rep_id
}

enum PermissionAction {
  read
  create
  update
  delete
  invite
  suspend
  assign_role
  approve
  upload
  export
  receive
}

enum PermissionSubject {
  User
  Org
  Role
  Invitation
  OrgDocument
  AuditLog
  Notification
}


// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Org {
  id                      String    @id @default(uuid())
  name                    String    @unique @db.VarChar(200)
  slug                    String    @unique @db.VarChar(200)
  org_type                OrgType
  status                  OrgStatus @default(pending)
  tin                     String    @unique @db.VarChar(9)
  license_number          String?   @unique @db.VarChar(100)
  contact_email              String    @db.VarChar(255)
  contact_phone              String    @db.VarChar(20)
  address                    String?   @db.VarChar(500)
  logo_path                  String?
  parent_org_id              String?
  approved_by                String?
  approved_at                DateTime?
  rejection_reason           String?
  cooperative_approved_at    DateTime?
  contact_email_verified_at  DateTime?
  contact_otp_hash           String?
  contact_otp_expires_at     DateTime?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  deleted_at                 DateTime?

  parent_org Org?         @relation("OrgHierarchy", fields: [parent_org_id], references: [id])
  child_orgs Org[]        @relation("OrgHierarchy")
  users      User[]
  roles      Role[]
  documents  OrgDocument[]

  @@map("orgs")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  org_id      String?
  is_managed  Boolean  @default(false)
  created_at  DateTime @default(now())

  org          Org?         @relation(fields: [org_id], references: [id])
  user_roles   UserRole[]
  invitations  Invitation[]
  role_grants  RoleGrant[]

  @@unique([slug, org_id])
  @@map("roles")
}

model User {
  id                         String       @id @default(uuid())
  first_name                 String       @db.VarChar(100)
  last_name                  String       @db.VarChar(100)
  phone_number               String?      @unique @db.VarChar(20)
  phone_verified_at          DateTime?
  email                      String?      @unique @db.VarChar(255)
  email_verified_at          DateTime?
  password_hash              String?
  user_type                  UserType
  status                     UserStatus   @default(pending_verification)
  login_channel              LoginChannel?
  two_factor_enabled         Boolean      @default(false)
  avatar_path                String?
  notif_channel              String[]     @default(["sms", "email"])
  locale                     String       @default("rw") @db.VarChar(5)
  fcm_token                  String?
  org_id                     String?
  driver_license_number      String?      @db.VarChar(100)
  driver_license_verified_at DateTime?
  last_login_at              DateTime?
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt
  deleted_at                 DateTime?

  org            Org?           @relation(fields: [org_id], references: [id])
  refresh_tokens RefreshToken[]
  otps           Otp[]
  user_roles     UserRole[]
  user_grants    UserGrant[]

  @@map("users")
}

model Permission {
  id           String            @id @default(uuid())
  code         String            @unique @db.VarChar(60)
  action       PermissionAction
  subject      PermissionSubject
  display_name String            @db.VarChar(100)
  description  String            @db.VarChar(255)
  group        String            @db.VarChar(50)

  @@unique([action, subject])
  @@map("permissions")
}

// A grant is a pattern string assigned to a role or user.
// Pattern format: "{subject|*}:{action|*}:{scope}"   e.g. "*:*:platform", "user:*:own"
// Scope must always be explicit (own | org | platform) — no wildcard on scope.
// is_managed=true means the grant was seeded by the platform and cannot be removed via API.

model RoleGrant {
  id         String   @id @default(uuid())
  role_id    String
  pattern    String   @db.VarChar(80)
  is_managed Boolean  @default(false)
  created_at DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, pattern])
  @@map("role_grants")
}

model UserGrant {
  id         String   @id @default(uuid())
  user_id    String
  pattern    String   @db.VarChar(80)
  is_managed Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern])
  @@map("user_grants")
}

model UserRole {
  user_id    String
  role_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  token_hash  String    @unique
  user_id     String
  device_name String?   @db.VarChar(200)
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(500)
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model Otp {
  id         String    @id @default(uuid())
  user_id    String
  purpose    String    @db.VarChar(30)
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@map("otps")
}


model Invitation {
  id           String    @id @default(uuid())
  email        String?   @db.VarChar(255)
  phone_number String?   @db.VarChar(20)
  first_name   String    @db.VarChar(100)
  last_name    String    @db.VarChar(100)
  role_id      String?
  org_id       String?
  invited_by   String
  locale       String?   @db.VarChar(5)
  token_hash   String    @unique
  expires_at   DateTime
  accepted_at  DateTime?
  created_at   DateTime  @default(now())

  role Role? @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@map("invitations")
}

model OrgDocument {
  id         String     @id @default(uuid())
  org_id     String
  doc_type   OrgDocType
  s3_path    String
  mime_type  String     @db.VarChar(100)
  created_at DateTime   @default(now())

  org Org @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@map("org_documents")
}
